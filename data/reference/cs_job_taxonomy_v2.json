{
 "version": "2.0",
 "date": "2026-11-05",
 "built_from": "roadmap.sh role roadmaps (public repo folders) plus clearly flagged extension sub-domains that roadmap.sh does not cover",
 "fallback_categories": {
  "N": {
   "name": "Non-Tech",
   "sub_domain": "Not applicable",
   "use_when": "The role is clearly outside computer science and IT (sales, HR, legal, creative, retail, healthcare, finance, operations, SEO) and no taxonomy sub-domain fits. Always set a reason_code."
  },
  "U": {
   "name": "Unclassified",
   "sub_domain": "Not applicable",
   "use_when": "The title or text is ambiguous, unparseable, or the best taxonomy match is below the confidence threshold. Always set a reason_code. Queued for owner review; never guessed."
  }
 },
 "rules": {
  "is_tech_role": "true for every row whose category is C1-C7; false for Non-Tech and Unclassified. No exceptions and no 'strictly technical' judgement.",
  "tier": "core | adjacent (C5 Product, Design & Management) | extension flag via source field. Use tier and source to filter analyses.",
  "extension_toggle": "If config include_extensions=false, rows matching sub-domains with source=extension go to Unclassified (reason_code=extension_disabled) so the owner can decide later.",
  "skills_fallback": "Skills only choose between existing sub-domains when the title is ambiguous. They never create a new category.",
  "confidence": {
   "HIGH": ">=0.85",
   "MEDIUM": "0.70-0.84",
   "LOW": "<0.70 -> category Unclassified"
  },
  "reason_codes": [
   "no_title_match",
   "ambiguous_title",
   "conflicting_skills",
   "low_confidence",
   "clearly_non_cs",
   "unparseable_text",
   "extension_disabled",
   "non_english_unmatched"
  ]
 },
